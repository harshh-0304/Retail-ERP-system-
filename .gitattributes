# Normalize line endings on checkin
* text=auto eol=lf

*.cs   text
*.js   text
*.jsx  text
*.json text
*.css  text
*.html text
*.md   text

# Windows-specific scripts keep CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary
*.ico  binary
*.png  binary
*.jpg  binary
*.woff binary
*.woff2 binary
